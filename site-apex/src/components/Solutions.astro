---
import { Button } from '@ds';
import { solutions } from '../data/site';
---
<section class="solutions" id="solucoes" data-solutions aria-labelledby="sol-title">
  <div class="sol-stage" data-sol-stage>
    <div class="sol-head wrap">
      <h2 id="sol-title" class="title">O Apex cobre os dois lados do automobilismo</h2>
    </div>

    <div class="panels wrap">
      {solutions.map((s, i) => (
        <article class={`panel panel-${s.id}`} data-reveal>
          <div class="visual" aria-hidden="true">
            {s.id === 'eventos' ? (
              <img
                class="photo" src="/images/organize-o-evento-1200.webp"
                srcset="/images/organize-o-evento-800.webp 800w, /images/organize-o-evento-1200.webp 1200w"
                sizes="(min-width: 900px) 560px, 100vw" alt="" width="1200" height="396" loading="lazy" decoding="async"
              />
            ) : (
              <div class="slots">
                {Array.from({ length: 24 }).map((_, k) => <span class:list={['slot', [3, 4, 9, 14, 15, 16, 21].includes(k) && 'on']} />)}
              </div>
            )}
            {s.id !== 'eventos' && <span class="material-symbols-outlined big">{s.icon}</span>}
          </div>

          <div class="copy">
            <p class="kicker">{s.kicker}</p>
            <h3 class="panel-title">{s.title}</h3>
            <p class="lead">{s.text}</p>
            <p class="value"><span class="material-symbols-outlined" aria-hidden="true">target</span>{s.value}</p>
            <Button href={s.href} variant={i === 0 ? 'primary' : 'outline'}>{s.cta}</Button>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .solutions { position: relative; padding-block: clamp(48px, 6vw, 96px); overflow: clip;
    background: var(--scene-bg); }
  .sol-head { margin-bottom: clamp(20px, 3vw, 40px); }
  .sol-head .title { font: var(--site-subtitle); letter-spacing: var(--site-subtitle-tracking); max-width: 22ch; }
  .sol-head .kicker { margin-bottom: var(--spacing-sm); }
  /* Notebook: a seção inteira cabe numa tela */
  @media (min-width: 900px) { .solutions { padding-block: 100px; } }
  @media (max-height: 820px) and (min-width: 900px) { .solutions { padding-block: 100px; } }
  /* Os dois cartões lado a lado (empilham no mobile) */
  .panels { display: grid; gap: var(--spacing-lg); grid-template-columns: 1fr; align-items: stretch; }
  @media (min-width: 900px) { .panels { grid-template-columns: 1fr 1fr; } }
  .panel {
    display: flex; flex-direction: column; gap: var(--spacing-md);
    border: var(--border-width-thin) solid var(--scene-line); border-radius: var(--radius-overlay);
    padding: clamp(var(--spacing-md), 2vw, var(--spacing-xl)); background: color-mix(in oklab, var(--scene-bg) 96%, var(--color-gray-50) 4%);
    transition: border-color var(--transition-normal);
  }
  .panel:hover { border-color: var(--color-brand-500); }
  .copy { display: flex; flex-direction: column; flex: 1; align-items: flex-start; }
  .copy :global(.btn) { margin-top: auto; }

  .visual {
    position: relative; aspect-ratio: 16 / 5; border-radius: var(--radius-card); overflow: hidden;
    display: grid; place-items: center; color: var(--color-brand-500);
    background: radial-gradient(circle at 30% 20%, color-mix(in oklab, var(--brand-primary) 24%, transparent), transparent 60%), var(--color-gray-900);
  }
  /* Foto do cartão de Eventos: preenche o visual (decorativa) */
  .photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 55%; transform: scaleX(-1); }
  .slots { display: grid; grid-template-columns: repeat(12, 1fr); gap: var(--spacing-xs); width: 82%; }
  .slot { aspect-ratio: 1.4; border-radius: var(--radius-control-sm); border: var(--border-width-thin) solid var(--scene-line); }
  .slot.on { background: var(--color-brand-500); border-color: var(--color-brand-500); }
  .big { position: absolute; right: var(--spacing-md); bottom: var(--spacing-sm); font-size: var(--spacing-2xl); color: var(--scene-fg); opacity: 0.9; }
  .panel-title { font: var(--text-heading-6); letter-spacing: var(--text-heading-6-tracking); margin: 0; text-wrap: balance; }
  .copy .kicker { margin-bottom: var(--spacing-xs); }
  .copy .lead { margin-top: var(--spacing-sm); font-size: var(--font-size-base); }
  @media (max-width: 720px) { .panel-title { font: var(--text-heading-6); letter-spacing: var(--text-heading-6-tracking); } .visual { aspect-ratio: 16 / 7; } }
  .value { display: flex; gap: var(--spacing-sm); align-items: flex-start; margin: var(--spacing-md) 0 var(--spacing-lg); color: var(--scene-fg); font-size: var(--font-size-sm); }
  .value .material-symbols-outlined { color: var(--color-brand-400); font-size: var(--font-size-xl); }
</style>
