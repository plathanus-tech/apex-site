---
/** Moldura de janela (barra com três pontos e rótulo) para telas do sistema e exemplos de página. */
interface Props { label?: string }
const { label } = Astro.props;
---
<figure class="win">
  <figcaption class="bar"><i></i><i></i><i></i>{label && <span class="lbl">{label}</span>}</figcaption>
  <div class="body"><slot /></div>
</figure>

<style>
  .win { margin: 0; overflow: hidden; border-radius: var(--radius-card); border: var(--border-width-thin) solid var(--scene-line);
    background: var(--color-gray-white); box-shadow: var(--shadow-2xl); display: flex; flex-direction: column; }
  .bar { display: flex; align-items: center; gap: var(--spacing-xs); padding: var(--spacing-sm) var(--spacing-md); background: var(--color-gray-800); }
  .bar i { width: var(--spacing-sm); height: var(--spacing-sm); border-radius: var(--radius-full); background: var(--color-gray-600); }
  .lbl { margin-left: var(--spacing-sm); font: var(--text-caption-s); letter-spacing: var(--text-caption-s-tracking); color: var(--scene-fg-muted); }
  .body { position: relative; flex: 1; min-height: 0; }
  .body :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top left; }
</style>
