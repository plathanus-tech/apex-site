---
import { compare } from '../../data/eventos';
---
<section class="cmp section" aria-labelledby="cmp-title">
  <div class="wrap">
    <h2 id="cmp-title" class="title">{compare.title}</h2>

    <div class="duo">
      <div class="side without" data-reveal>
        <p class="tag">Sem Apex</p>
        <ul class="mess">
          {compare.without.map((t) => (
            <li><span class="material-symbols-outlined ic" aria-hidden="true">close</span>{t}</li>
          ))}
        </ul>
      </div>

      <div class="arrow" aria-hidden="true"><span class="material-symbols-outlined">arrow_forward</span></div>

      <div class="side with" data-reveal>
        <p class="tag brand">Com Apex</p>
        <ul class="clean">
          {compare.with.map((t) => (
            <li><span class="material-symbols-outlined ic" aria-hidden="true">check_circle</span>{t}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .cmp { background: var(--color-gray-800); }
  /* Desktop: o painel do Hero invade o topo desta seção, então ela ganha esse espaço a mais em cima */
  @media (min-width: 1000px) { .cmp { padding-top: calc(100px + var(--ev-overlap)); } }
  .duo { margin-top: var(--spacing-3xl); display: grid; gap: var(--spacing-lg); align-items: stretch; }
  @media (min-width: 900px) { .duo { grid-template-columns: 1fr auto 1.1fr; gap: var(--spacing-xl); align-items: center; } }
  /* Celular: 16px entre o título e os blocos */
  @media (max-width: 599px) { .duo { margin-top: var(--spacing-md); } }
  .arrow { display: none; color: var(--color-brand-500); }
  .arrow .material-symbols-outlined { font-size: 40px; }
  @media (min-width: 900px) { .arrow { display: block; } }

  .tag { margin: 0 0 var(--spacing-lg); font: var(--site-kicker); letter-spacing: var(--site-kicker-tracking); text-transform: uppercase; color: var(--color-gray-300); }
  .tag.brand { color: var(--color-brand-400); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--spacing-sm); }
  li { display: flex; align-items: center; gap: var(--spacing-sm); }
  .ic { font-size: var(--font-size-2xl); flex: none; }

  /* Sem Apex: itens soltos, tortos, tracejados e apagados, como papéis espalhados */
  .without { padding: var(--spacing-lg) 0; }
  .mess li { padding: var(--spacing-sm) var(--spacing-md); border: var(--border-width-thin) dashed var(--color-gray-600); border-radius: var(--radius-control);
    color: var(--color-gray-300); width: fit-content; max-width: 100%; }
  .mess .ic { color: var(--color-gray-500); }
  .mess li:nth-child(1) { transform: rotate(-1.6deg); }
  .mess li:nth-child(2) { transform: rotate(1.2deg) translateX(var(--spacing-md)); }
  .mess li:nth-child(3) { transform: rotate(-0.8deg) translateX(var(--spacing-xs)); }
  .mess li:nth-child(4) { transform: rotate(1.8deg) translateX(calc(var(--spacing-lg))); }
  .mess li:nth-child(5) { transform: rotate(-1.2deg); }
  @media (max-width: 899px) { .mess li:nth-child(n) { transform: none; } }

  /* Com Apex: tudo alinhado em um único painel organizado */
  .with { padding: var(--spacing-xl); border-radius: var(--radius-card); border: var(--border-width-thin) solid var(--color-brand-500);
    background: color-mix(in oklab, var(--color-brand-500) 8%, var(--color-gray-900)); box-shadow: 0 0 0 1px color-mix(in oklab, var(--color-brand-500) 30%, transparent), var(--shadow-2xl); }
  .clean li { padding: var(--spacing-sm) 0; border-bottom: var(--border-width-thin) solid var(--scene-line); font-weight: var(--font-weight-label); }
  .clean li:last-child { border-bottom: 0; }
  .clean .ic { color: var(--color-brand-500); }
</style>
