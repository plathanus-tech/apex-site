---
import { Badge } from '@ds';
import { statusLabel, type EventItem } from '../../data/eventos';
const { event } = Astro.props as { event: EventItem };
const tone = event.status === 'abertas' ? 'success' : event.status === 'breve' ? 'warning' : 'neutral';
---
<article class="ev" data-event-card data-search={`${event.title} ${event.venue} ${event.place}`.toLowerCase()}>
  <a class="link" href={event.href} aria-label={`Ver o evento ${event.title}`}>
    <div class="img">
      {event.image
        ? <img src={event.image} alt="" loading="lazy" decoding="async" />
        : <span class="ph" aria-hidden="true"><span class="material-symbols-outlined">image</span><span>[Imagem do evento]</span></span>}
    </div>
    <div class="body">
      <Badge status={tone}>{statusLabel[event.status]}</Badge>
      <h3>{event.title}</h3>
      <ul class="meta">
        <li><span class="material-symbols-outlined" aria-hidden="true">calendar_month</span>{event.dates}</li>
        <li><span class="material-symbols-outlined" aria-hidden="true">flag</span>{event.venue}</li>
        <li><span class="material-symbols-outlined" aria-hidden="true">location_on</span>{event.place}</li>
      </ul>
    </div>
  </a>
</article>

<style>
  .ev { border: var(--border-width-thin) solid var(--scene-line); border-radius: var(--radius-card); background: var(--color-gray-900); transition: border-color var(--transition-normal); height: 100%; }
  .ev:hover { border-color: var(--color-brand-500); }
  .link { display: grid; gap: calc(var(--spacing-md) + var(--spacing-xs)); padding: calc(var(--spacing-sm) + var(--spacing-xs)); color: inherit; text-decoration: none; height: 100%; align-content: start; }
  .link:focus-visible { outline: 2px solid var(--color-brand-400); outline-offset: 2px; border-radius: var(--radius-card); }
  .img { aspect-ratio: 16 / 10; border-radius: var(--radius-control); overflow: hidden; background: var(--color-gray-800); }
  .img img { width: 100%; height: 100%; object-fit: cover; }
  .ph { height: 100%; display: grid; place-content: center; justify-items: center; gap: var(--spacing-2xs); color: var(--scene-fg-muted); font: var(--text-caption-s); border: 1px dashed var(--color-gray-600); border-radius: var(--radius-control); }
  .ph .material-symbols-outlined { font-size: var(--spacing-2xl); color: var(--color-brand-500); }
  .body { display: grid; gap: var(--spacing-sm); justify-items: start; padding: 0; }
  h3 { margin: 0; font: var(--text-heading-6); letter-spacing: var(--text-heading-6-tracking); font-size: var(--font-size-xl); }
  .meta { list-style: none; margin: var(--spacing-xs) 0 0; padding: 0; display: grid; gap: var(--spacing-xs); color: var(--scene-fg-muted); font: var(--text-body-s); }
  .meta li { display: flex; align-items: center; gap: var(--spacing-sm); }
  .meta .material-symbols-outlined { font-size: var(--font-size-xl); color: var(--scene-fg); flex: none; }
</style>
