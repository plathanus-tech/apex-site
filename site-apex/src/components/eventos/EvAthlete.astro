---
import Win from './Win.astro';
import { athlete } from '../../data/eventos';
---
<section class="ath section" aria-labelledby="ath-title">
  <div class="wrap grid">
    <div class="copy">
      <h2 id="ath-title" class="title">{athlete.title}</h2>
      <ul class="list">
        {athlete.items.map((i) => (
          <li><span class="material-symbols-outlined ico" aria-hidden="true">{i.icon}</span>{i.label}</li>
        ))}
      </ul>
      <p class="note"><span class="material-symbols-outlined" aria-hidden="true">flag</span>{athlete.note}</p>
    </div>

    <div class="mock">
      <div class="desk">
        <Win label="Página do campeonato (exemplo)">
          <img src="/images/landing-pista.webp" width="1366" height="1500" loading="lazy" decoding="async"
            alt="Exemplo de página pública de um campeonato criada no Apex: apresentação, etapas com a situação das inscrições e ranking" />
        </Win>
      </div>
      <div class="phone">
        <img src="/images/landing-mobile.webp" width="430" height="4864" loading="lazy" decoding="async"
          alt="A mesma página de campeonato no celular: abertura, progresso da temporada e ranking" />
      </div>
      <p class="cap">Exemplo de página de campeonato criada no Apex, no computador e no celular</p>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; gap: var(--spacing-3xl); align-items: center; }
  @media (min-width: 960px) { .grid { grid-template-columns: 1fr 1.15fr; gap: var(--spacing-4xl); } }
  .list { list-style: none; margin: var(--spacing-xl) 0 0; padding: 0; display: grid; gap: var(--spacing-md); }
  .list li { display: flex; align-items: center; gap: var(--spacing-md); font: var(--text-heading-6); font-size: var(--font-size-xl); letter-spacing: var(--text-heading-6-tracking); }
  .ico { font-size: var(--font-size-2xl); color: var(--color-brand-500); }
  .note { margin: var(--spacing-xl) 0 0; display: flex; gap: var(--spacing-sm); align-items: flex-start; padding: var(--spacing-md);
    border-left: 3px solid var(--color-brand-500); background: color-mix(in oklab, var(--color-brand-500) 8%, transparent); border-radius: 0 var(--radius-control) var(--radius-control) 0; color: var(--scene-fg); }
  .note .material-symbols-outlined { color: var(--color-brand-500); flex: none; }

  .mock { position: relative; padding-bottom: var(--spacing-3xl); }
  .desk :global(.win) { height: clamp(300px, 42vw, 520px); }
  .phone { position: absolute; left: var(--spacing-md); bottom: var(--spacing-xl); width: clamp(120px, 24%, 190px); aspect-ratio: 430 / 880; overflow: hidden;
    border-radius: 24px; border: 6px solid var(--color-gray-800); background: var(--color-gray-white); box-shadow: var(--shadow-2xl); }
  .phone img { width: 100%; height: 100%; object-fit: cover; object-position: top left; }
  .cap { position: absolute; right: 0; bottom: 0; margin: 0; max-width: 62%; text-align: right; font: var(--text-caption-s); color: var(--scene-fg-muted); }
</style>
