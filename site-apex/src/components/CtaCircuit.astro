---
/** Fundo da seção final de todas as páginas: o traçado da pista é desenhado pela rolagem (ver scripts/micro.ts). */
---
  <!-- Pista: o traçado laranja é desenhado pela rolagem e um ponto de luz percorre o circuito até a linha de chegada -->
  <svg class="circuit circuit-d" viewBox="0 0 1200 600" fill="none" preserveAspectRatio="xMaxYMid slice" aria-hidden="true">
    <path class="road" d="M-20 520 C 120 520 200 520 300 505 C 420 487 470 420 420 360 C 370 300 260 300 250 230 C 240 160 330 120 440 140 C 540 158 560 240 640 250 C 740 262 790 170 880 150 C 980 128 1060 190 1040 270 C 1020 350 900 360 900 430 C 900 480 1000 440 1050 395 S 1120 325 1180 272" />
    <path class="trace" data-circuit d="M-20 520 C 120 520 200 520 300 505 C 420 487 470 420 420 360 C 370 300 260 300 250 230 C 240 160 330 120 440 140 C 540 158 560 240 640 250 C 740 262 790 170 880 150 C 980 128 1060 190 1040 270 C 1020 350 900 360 900 430 C 900 480 1000 440 1050 395 S 1120 325 1180 272" />
    <g class="finish" transform="translate(1143 303) rotate(-40)">
      <path d="M0 -22 L0 22" class="chk" />
      <path d="M7 -22 L7 22" class="chk off" />
    </g>
    <circle class="racer" data-racer r="7" cx="-20" cy="520" />
  </svg>
  <!-- Versão do celular: a pista desce pela seção e termina abaixo do card do formulário -->
  <svg class="circuit circuit-m" viewBox="0 0 400 1000" fill="none" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
    <path class="road" d="M-20 90 C 90 70 190 110 215 190 C 240 270 90 290 80 380 C 70 470 210 480 250 560 C 290 640 330 700 300 760 C 270 820 120 800 80 860 C 50 905 70 962 150 964 L 330 964" />
    <path class="trace" data-circuit d="M-20 90 C 90 70 190 110 215 190 C 240 270 90 290 80 380 C 70 470 210 480 250 560 C 290 640 330 700 300 760 C 270 820 120 800 80 860 C 50 905 70 962 150 964 L 330 964" />
    <g class="finish" transform="translate(300 964)">
      <path d="M0 -22 L0 22" class="chk" />
      <path d="M7 -22 L7 22" class="chk off" />
    </g>
    <circle class="racer" data-racer r="7" cx="-20" cy="90" />
  </svg>

<style>
  .circuit-m { display: block; }
  .circuit-d { display: none; }
  @media (min-width: 960px) { .circuit-m { display: none; } .circuit-d { display: block; } }
  .circuit { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; opacity: 0.4; }
  .road { stroke: var(--color-gray-800); stroke-width: 22; stroke-linecap: round; stroke-linejoin: round; opacity: 0.7; }
  .trace { stroke: var(--color-brand-500); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .chk { stroke: var(--color-gray-50); stroke-width: 7; stroke-dasharray: 7 7; }
  .chk.off { stroke-dashoffset: 7; }
  .racer { fill: var(--color-brand-400); filter: drop-shadow(0 0 8px var(--color-brand-500)) drop-shadow(0 0 18px var(--color-brand-500)); }
</style>
