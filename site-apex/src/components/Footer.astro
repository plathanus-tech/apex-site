---
import { nav } from '../data/site';
---
<footer class="footer">
  <div class="wrap inner">
    <img src="/brand/logo-apex-branco.svg" alt="Apex" width="1141" height="510" />
    <nav aria-label="Rodapé">
      <ul>{nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
    </nav>
    <p>© Apex. Plataforma para eventos e reservas no automobilismo.</p>
  </div>
</footer>

<style>
  .footer { border-top: var(--border-width-thin) solid var(--scene-line); padding-block: var(--spacing-3xl); }
  .inner { display: grid; gap: var(--spacing-xl); }
  /* Logo: altura da escala (spacing-2xl) mais 32px */
  img { height: calc(var(--spacing-2xl) + var(--spacing-xl)); width: auto; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--spacing-lg); }
  a { text-decoration: none; color: var(--scene-fg-muted); font: var(--text-body-s); letter-spacing: var(--text-body-s-tracking); }
  a:hover { color: var(--scene-fg); }
  a:focus-visible { outline: var(--focus-ring-width) solid var(--focus-ring-color); outline-offset: var(--focus-ring-offset); }
  p { margin: 0; color: var(--scene-fg-muted); font: var(--text-caption-s); letter-spacing: var(--text-caption-s-tracking); }
</style>
