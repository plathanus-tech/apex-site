---
import { payments } from '../../data/reservas';
const { fee, timing, panel } = payments;
---
<section class="py section" aria-labelledby="py-title">
  <div class="wrap grid">
    <div class="copy">
      <h2 id="py-title" class="title">{payments.title}</h2>
      <p class="lead">{payments.lead}</p>

      <!-- Quando o valor chega ao painel e o que o painel mostra -->
      <div class="when">
        <p class="fl">Quando o valor chega ao painel</p>
        <dl class="times">
          {timing.map((t) => (<div class="time"><dd>{t.value}</dd><dt>{t.label}</dt></div>))}
        </dl>
        <p class="fl">{panel.title}</p>
        <ul class="panel-list">
          {panel.items.map((i) => (<li>{i}</li>))}
        </ul>
      </div>

      <div class="fee">
        <p class="fl">{fee.title}</p>
        <p class="ft">{fee.text}</p>
        <p class="fl">{fee.payersTitle}</p>
        <ul class="payers">
          {fee.payers.map((w, i) => (<li>{i > 0 && <span class="or" aria-hidden="true">ou</span>}<span class="who">{w}</span></li>))}
        </ul>
        <p class="cap">{fee.payersCaption}</p>
      </div>
      <p class="placeholder-tag">{payments.pending}</p>
    </div>

    <!-- Caminho do dinheiro: da reserva ao repasse -->
    <ol class="flow">
      {payments.steps.map((s) => (
        <li>
          <span class="material-symbols-outlined ic" aria-hidden="true">{s.icon}</span>
          <div class="tx"><strong>{s.title}</strong><span>{s.text}</span></div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .py { background: var(--scene-bg); }
  .grid { display: grid; gap: var(--spacing-3xl); align-items: center; }
  @media (min-width: 960px) { .grid { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: var(--spacing-4xl); } }

  .when { margin-top: var(--spacing-2xl); display: grid; gap: var(--spacing-2xs); }
  .times { margin: 0 0 var(--spacing-md); display: grid; grid-template-columns: 1fr 1fr; border-top: var(--border-width-thin) solid var(--scene-line); }
  .time { display: flex; flex-direction: column-reverse; gap: var(--spacing-2xs); padding-top: var(--spacing-md); }
  .time + .time { padding-left: var(--spacing-lg); border-left: var(--border-width-thin) solid var(--scene-line); }
  .time dd { margin: 0; font: var(--site-title); font-size: clamp(24px, 2.6vw, 34px); letter-spacing: var(--site-title-tracking); color: var(--color-brand-400); }
  .time dt { font: var(--site-kicker); letter-spacing: var(--site-kicker-tracking); text-transform: uppercase; color: var(--scene-fg-muted); }
  .panel-list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--spacing-xs); font: var(--text-body-l); }
  .panel-list li::before { content: ''; display: inline-block; width: var(--spacing-xs); height: var(--spacing-xs); border-radius: 50%; background: var(--color-brand-500); margin-right: var(--spacing-sm); vertical-align: middle; }
  .fee { margin-top: var(--spacing-2xl); display: grid; gap: var(--spacing-2xs); }
  .fl { margin: var(--spacing-md) 0 0; font: var(--site-kicker); letter-spacing: var(--site-kicker-tracking); text-transform: uppercase; color: var(--scene-fg-muted); }
  .fl:first-child { margin-top: 0; }
  .ft { margin: 0; font: var(--text-body-l); max-width: 48ch; }
  .payers { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--spacing-sm); font: var(--text-body-l); }
  .payers li { display: flex; align-items: baseline; gap: var(--spacing-sm); }
  .who { font-weight: var(--font-weight-bold, 700); }
  .or { font: var(--text-body-m); color: var(--scene-fg-muted); }
  .cap { margin: 0; font: var(--text-body-s); color: var(--scene-fg-muted); }

  .flow { list-style: none; margin: 0; padding: var(--spacing-xl); display: grid; gap: var(--spacing-lg); border-radius: var(--radius-card);
    border: var(--border-width-thin) solid var(--scene-line); background: var(--color-gray-900); box-shadow: var(--shadow-2xl); position: relative; }
  /* Linha que liga os três passos */
  .flow::before { content: ''; position: absolute; left: calc(var(--spacing-xl) + var(--spacing-md) + 12px); top: calc(var(--spacing-xl) + 32px); bottom: calc(var(--spacing-xl) + 32px);
    width: 2px; background: repeating-linear-gradient(180deg, var(--color-brand-500) 0 6px, transparent 6px 12px); opacity: 0.7; }
  .flow li { position: relative; display: grid; grid-template-columns: auto 1fr; gap: var(--spacing-md); align-items: center; padding: var(--spacing-md);
    border: var(--border-width-thin) solid var(--scene-line); border-radius: var(--radius-control); background: var(--scene-bg); }
  .flow li:last-child { border-color: var(--color-brand-500); }
  .ic { font-size: var(--spacing-xl); color: var(--color-brand-500); background: var(--scene-bg); }
  .tx { display: grid; gap: 2px; }
  .tx strong { font: var(--text-heading-6); letter-spacing: var(--text-heading-6-tracking); }
  .tx span { color: var(--scene-fg-muted); font: var(--text-body-s); }
</style>
