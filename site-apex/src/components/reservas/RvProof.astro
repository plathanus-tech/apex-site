---
import { proof } from '../../data/reservas';
const real = proof.logos.length > 0;
---
<section class="pf section" aria-labelledby="rv-pf-title">
  <div class="wrap">
    <h2 id="rv-pf-title" class="title">{proof.title}</h2>
    <ul class="logos">
      {real
        ? proof.logos.map((l) => (<li><img src={l.logo} alt={l.name} loading="lazy" decoding="async" /><span class="nm">{l.name}</span></li>))
        : Array.from({ length: proof.placeholders }, (_, i) => (<li class="ph"><span class="lg">Logo</span><span class="sr-only">Logo da empresa {i + 1}</span></li>))}
    </ul>
    {!real && <p class="placeholder-tag">Os logos são placeholders: substituir pelas empresas reais e autorizadas antes de publicar</p>}
  </div>
</section>

<style>
  /* Vem logo depois do hero: a tela da agenda avança sobre esta seção e o fundo desce em gradiente até o gray-800 */
  .pf { background: var(--color-gray-800); }
  @media (min-width: 900px) { .pf { padding-top: calc(100px + var(--rv-overlap, 0px)); } }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .logos { list-style: none; margin: var(--spacing-3xl) 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--spacing-md); }
  @media (min-width: 700px) { .logos { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1000px) { .logos { grid-template-columns: repeat(6, 1fr); } }
  .logos li { display: grid; justify-items: center; align-content: center; gap: var(--spacing-sm); min-height: 96px; padding: var(--spacing-md);
    border: var(--border-width-thin) solid var(--scene-line); border-radius: var(--radius-control); background: var(--color-gray-900); }
  .logos li.ph { border-style: dashed; border-color: var(--color-gray-600); background: transparent; }
  .logos img { display: block; max-width: 100%; max-height: 48px; width: auto; height: auto; object-fit: contain; }
  .nm { font: var(--text-body-s); letter-spacing: var(--text-body-s-tracking); color: var(--scene-fg-muted); text-align: center; }
  .lg { font: var(--text-caption-s); letter-spacing: var(--text-caption-s-tracking); text-transform: uppercase; color: var(--scene-fg-muted); }
</style>
