---
import PricingPlans from '../eventos/PricingPlans';
import { pricing } from '../../data/reservas';
---
<section class="pr section" aria-labelledby="rv-pr-title">
  <div class="wrap">
    <h2 id="rv-pr-title" class="title">{pricing.title}</h2>
    <div class="plans"><PricingPlans client:visible plans={pricing.plans} /></div>
  </div>
</section>

<style>
  /* Seção clara (gray-50); o conteúdo das abas define as cores escuras */
  .pr { background: var(--color-gray-50); color: var(--color-gray-900);
    --scene-fg: var(--color-gray-900); --scene-fg-muted: var(--color-gray-600); --scene-line: var(--color-gray-300); }
  /* Celular: o botão "Solicitar demonstração" dos planos ocupa a largura toda */
  @media (max-width: 599px) { .pr :global([class*='cta'] a) { display: flex; width: 100%; justify-content: center; } }
  /* Celular: 16px entre o título e as abas (o componente traz 64px de margem própria, que aqui é descontada) */
  @media (max-width: 599px) { .plans { margin-top: calc(var(--spacing-md) - var(--spacing-3xl)); } }
  /* Duas abas lado a lado (o componente reserva uma coluna no celular e três no desktop) */
  .pr :global([role='tablist']) { grid-template-columns: repeat(2, 1fr); gap: var(--spacing-sm); }
  @media (min-width: 760px) { .pr :global([role='tablist']) { gap: var(--spacing-md); } }
</style>
