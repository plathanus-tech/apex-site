---
import PricingPlans from '../eventos/PricingPlans';
import { pricing } from '../../data/reservas';
---
<section class="pr section" aria-labelledby="rv-pr-title">
  <div class="wrap">
    <h2 id="rv-pr-title" class="title">{pricing.title}</h2>
    <PricingPlans client:visible plans={pricing.plans} />
  </div>
</section>

<style>
  /* Seção clara (gray-50); o conteúdo das abas define as cores escuras */
  .pr { background: var(--color-gray-50); color: var(--color-gray-900);
    --scene-fg: var(--color-gray-900); --scene-fg-muted: var(--color-gray-600); --scene-line: var(--color-gray-300); }
</style>
