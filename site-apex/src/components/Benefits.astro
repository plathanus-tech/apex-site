---
import { generalBenefits } from '../data/site';
---
<!--
  Versão estática dos benefícios (grade). Com movimento permitido em telas grandes, os mesmos
  benefícios vêm de encontro à câmera dentro da cena do vídeo (CinematicIntro) e esta seção fica oculta
  (classe has-pov-benefits no <html>, ver intro.ts). A versão antiga em túnel está em BenefitsTunnel.astro.
-->
<section class="benefits section" id="beneficios" aria-labelledby="ben-title">
  <div class="wrap">
    <h2 id="ben-title" class="title">Uma plataforma para eventos e reservas com mais controle</h2>
    <p class="lead">Eventos e reservas em um só lugar, com a identidade da sua empresa.</p>

    <ol class="grid">
      {generalBenefits.map((b, i) => (
        <li class="card" data-reveal>
          <span class="material-symbols-outlined ico" aria-hidden="true">{b.icon}</span>
          <h3>{b.title}</h3>
          <p class="text">{b.text}</p>
        </li>
      ))}
    </ol>
    <p class="placeholder-tag">Texto-base a validar com o time do Apex</p>
  </div>
</section>

<style>
  .grid { list-style: none; margin: var(--spacing-3xl) 0 0; padding: 0; display: grid; gap: var(--spacing-xl); grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .card { display: grid; align-content: start; gap: var(--spacing-sm); border-top: var(--border-width-thin) solid var(--scene-line); padding-top: var(--spacing-lg); }
  .ico { font-size: var(--spacing-2xl); color: var(--color-brand-500); }
  .card h3 { margin: 0; font: var(--text-heading-6); letter-spacing: var(--text-heading-6-tracking); }
  .text { margin: 0; color: var(--scene-fg-muted); }
</style>
