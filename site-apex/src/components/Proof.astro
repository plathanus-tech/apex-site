---
import { proof } from '../data/site';
---
<section class="proof section" aria-labelledby="proof-title">
  <div class="wrap">
    <h2 id="proof-title" class="title">Quem organiza com o Apex</h2>

    <div class="quotes">
      {proof.testimonials.map((t) => (
        <figure class="quote" data-reveal>
          <p class="who">{t.solution}</p>
          <span class="mark" aria-hidden="true">“</span>
          <blockquote>{t.quote}</blockquote>
          <figcaption>
            <span class="logo" aria-hidden="true">Logo</span>
            <span class="by"><strong>{t.author}</strong><span>{t.role}</span></span>
          </figcaption>
        </figure>
      ))}
    </div>
    <p class="placeholder-tag">Depoimentos de exemplo (placeholders)</p>

    <dl class="stats">
      {proof.stats.map((s) => (
        <div class="stat" data-reveal>
          <dd><span data-count={s.value}>{s.value}</span>{s.suffix}</dd>
          <dt>{s.label}</dt>
        </div>
      ))}
    </dl>
    <p class="placeholder-tag">Números de exemplo (fictícios)</p>
  </div>
</section>

<style>
  /* Seção clara (gray-50): título, números e rótulos escuros; os cards de depoimento mantêm o visual escuro */
  .proof { background: var(--color-gray-50); color: var(--color-gray-900);
    --scene-fg: var(--color-gray-900); --scene-fg-muted: var(--color-gray-600); --scene-line: var(--color-gray-200); }
  .quotes { display: grid; gap: var(--spacing-lg); margin-top: var(--spacing-3xl); }
  @media (min-width: 800px) { .quotes { grid-template-columns: 1fr 1fr; gap: var(--spacing-xl); } }
  .quote { margin: 0; position: relative; display: flex; flex-direction: column; gap: var(--spacing-lg); padding: var(--spacing-xl);
    border: var(--border-width-thin) solid var(--scene-line); border-radius: var(--radius-card); background: var(--color-gray-800); color: var(--color-gray-50);
    --scene-fg: var(--color-gray-50); --scene-fg-muted: var(--color-gray-300); --scene-line: var(--color-gray-600); }
  .who { margin: 0; display: inline-flex; align-items: center; gap: var(--spacing-sm); font: var(--site-kicker); letter-spacing: var(--site-kicker-tracking); text-transform: uppercase; color: var(--scene-fg-muted); }
  .who::before { content: ''; width: var(--spacing-sm); height: var(--spacing-sm); border-radius: var(--radius-full); background: var(--color-brand-500); }
  .mark { font: var(--site-display); line-height: 0.6; height: var(--spacing-2xl); color: var(--color-brand-500); opacity: 0.6; }
  blockquote { margin: 0; flex: 1; font: var(--text-heading-5); letter-spacing: var(--text-heading-5-tracking); text-wrap: balance; }
  figcaption { display: flex; align-items: center; gap: var(--spacing-md); padding-top: var(--spacing-lg); border-top: var(--border-width-thin) solid var(--scene-line); }
  .logo { flex: none; width: var(--spacing-3xl); height: var(--spacing-3xl); border-radius: var(--radius-full); display: grid; place-items: center;
    border: var(--border-width-thin) dashed var(--color-gray-500); color: var(--scene-fg-muted); font: var(--text-caption-s); letter-spacing: var(--text-caption-s-tracking); text-transform: uppercase; }
  .by { display: grid; gap: var(--spacing-2xs); }
  .by span { color: var(--scene-fg-muted); }

  .stats { margin: var(--spacing-3xl) 0 0; display: grid; gap: 0; }
  @media (min-width: 800px) { .stats { grid-template-columns: repeat(3, 1fr); column-gap: var(--spacing-xl); } }
  .stat { display: flex; flex-direction: column-reverse; padding-block: var(--spacing-xl); }
  .stat dd { margin: 0; font: var(--site-title); letter-spacing: var(--site-title-tracking); color: var(--color-brand-500); font-variant-numeric: tabular-nums; }
  .stat dt { color: var(--scene-fg-muted); text-transform: uppercase; font: var(--site-kicker); letter-spacing: var(--site-kicker-tracking); margin-bottom: var(--spacing-sm); }
</style>
